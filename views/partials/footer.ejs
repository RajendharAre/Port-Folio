<footer class="bg-light-primary dark:bg-dark-primary border-t border-light-border dark:border-dark-border py-8">
  <div class="container mx-auto px-6">
    <div class="flex flex-col md:flex-row justify-between items-center">
      <div class="mb-4 md:mb-0">
        <p class="text-light-muted dark:text-dark-muted">
          &copy; <%= currentYear %>  <%= site.name %>. All rights reserved.
        </p>
      </div>
      <div class="flex space-x-6">
        <a href="<%= site.github %>" target="_blank" rel="noopener noreferrer" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-dark-accent transition">
          <span class="sr-only">GitHub</span>
          <iconify-icon icon="logos:github-icon" width="24" height="24" aria-hidden="true"></iconify-icon>
        </a>
        <a href="<%= site.linkedin %>" target="_blank" rel="noopener noreferrer" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-dark-accent transition">
          <span class="sr-only">LinkedIn</span>
          <iconify-icon icon="logos:linkedin-icon" width="24" height="24" aria-hidden="true"></iconify-icon>
        </a>
      </div>
    </div>
  </div>
</footer>